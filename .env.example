# Server only. Never prefix credentials with NUXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional alternative: path to an ignored service account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Or FIREBASE_SERVICE_ACCOUNT_KEY containing the complete JSON in production.

# Set to the site's exact public origin in production.
# ADMIN_ORIGIN=https://your-site.vercel.app

# One-time account provisioning only; do not add these to Vercel.
# ADMIN_BOOTSTRAP_USERNAME=admin01
# ADMIN_BOOTSTRAP_PASSWORD=

# Google Drive: owner OAuth credentials, server only (drive.file scope).
# Use a private folder created by this OAuth app; never a publicly shared folder.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_PDF_FOLDER_ID=
